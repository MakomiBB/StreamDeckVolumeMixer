{
  "name": "com.makomi.volumemixer",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "build:native": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:all": "npm run build:native && npm run build",
    "package:plugin": "powershell -ExecutionPolicy Bypass -File scripts/package-plugin.ps1"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.0.0",
    "rollup": "^4.9.6",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3"
  }
}
